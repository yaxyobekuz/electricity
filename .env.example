# ─────────────────────────────────────────────────────────────────────────────
# BEAP — muhit sozlamalari.  `.env` faylini shu namunadan nusxalang.
# Tizim TO'LIQ OFFLINE ishlaydi — bu yerda hech qanday tashqi xizmat manzili yo'q.
# ─────────────────────────────────────────────────────────────────────────────

# --- Ma'lumotlar bazasi ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=elektr_dev
PGUSER=postgres
PGPASSWORD=postgres
# Ulanishlar hovuzi
PG_POOL_MAX=10

# --- API ---
API_PORT=3001
# 0.0.0.0 — barcha tarmoq interfeyslarini tinglaydi, shunda LAN dagi boshqa
# qurilmalar ham API ga ulana oladi. Faqat shu kompyuter uchun: 127.0.0.1
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# --- Auth ---
# Ishlab chiqarishda ALBATTA almashtiring:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# --- Web ---
# Vite dev serveri ham barcha interfeyslarda ochiladi.
WEB_HOST=0.0.0.0
WEB_PORT=5173

# Shu kompyuterning LAN IP manzili — boshqa qurilmalar shu manzil orqali kiradi.
# `ipconfig` (Windows) yoki `ip addr` (Linux) bilan aniqlang.
HOST_IP=192.168.1.132

# Frontend qaysi manzilga so'rov yuboradi.
# Bo'sh qoldirilsa — nisbiy `/api` ishlatiladi (Vite proksi orqali).
# Absolyut manzil berilganda ham, sahifa boshqa hostdan ochilsa, klient
# avtomatik ravishda o'sha hostga moslashadi (`lib/api.ts` ga qarang).
VITE_API_BASE=http://192.168.1.132:3001/api

# --- AI yordamchi (ChatGPT) ---
# Ikkita IXTIYORIY tashqi xizmatdan biri (yana biri — pastdagi Telegram bot).
# Kalit BO'SH bo'lsa yordamchi butunlay o'chadi va tizim avvalgidek to'liq
# offline ishlaydi (panelda tugma ham chiqmaydi).
# Kalitni https://platform.openai.com/api-keys dan oling.
OPENAI_API_KEY=
# Model: gpt-4o-mini — arzon va tez; murakkab tahlil uchun gpt-4o
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Bitta javobdagi eng ko'p token — chat javobi qisqa bo'lishi kerak
OPENAI_MAX_TOKENS=700
OPENAI_TIMEOUT_MS=60000

# --- Telegram bot (ixtiyoriy) ---
# Ikkinchi IXTIYORIY tashqi xizmat. Token BO'SH bo'lsa bot butunlay o'chiq
# turadi — tizim avvalgidek to'liq offline ishlaydi. Bot xuddi shu AI
# yordamchidan foydalanadi, faqat Telegram orqali: foydalanuvchilar savol
# so'rashi va kunlik ogohlantirish digestini olishi mumkin.
# Tokenni @BotFather ga /newbot yuborib oling.
TELEGRAM_BOT_TOKEN=
# Kunlik ogohlantirish digesti yuboriladigan chat/guruh ID si.
# Bo'sh qoldirilsa — avtomatik push bo'lmaydi, ogohlantirishlar baribir
# botning chat interfeysi va veb panelning qo'ng'iroq belgisi orqali mavjud.
TELEGRAM_ALERT_CHAT_ID=
# Alohida bot workspace'i shu API ga qaysi manzildan murojaat qilishi.
# Faqat bot boshqa host/portda ishlaganda kerak — standart holatda shu yerdagi
# qiymat to'g'ri keladi.
BOT_API_BASE_URL=http://127.0.0.1:3001/api
