{
  "name": "beap",
  "version": "1.0.0",
  "private": true,
  "description": "BEAP - Baliqchi tumani Elektr energiya Analitik Platformasi",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "bot"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @beap/api",
    "dev:web": "npm run dev --workspace @beap/web",
    "dev:bot": "npm run dev --workspace @beap/bot",
    "start:bot": "npm run start --workspace @beap/bot",
    "build": "npm run build --workspace @beap/shared && npm run build --workspace @beap/api && npm run build --workspace @beap/web",
    "migrate": "npm run migrate --workspace @beap/api",
    "migrate:reset": "npm run migrate:reset --workspace @beap/api",
    "seed": "npm run seed --workspace @beap/api",
    "load:chinobod": "npm run load:july --workspace @beap/api && npm run load:august --workspace @beap/api && npm run fill:derived --workspace @beap/api && npm run works:inspection --workspace @beap/api",
    "verify:passport": "npm run verify:passport --workspace @beap/api",
    "verify:offline": "node scripts/scan-dist.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -b --pretty"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "qil": "^0.0.0"
  }
}
